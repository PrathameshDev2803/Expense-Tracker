# ----------------------------------------------------------------------
# Security & Access Restrictions
# ----------------------------------------------------------------------

# Disable directory browsing
Options -Indexes

# Protect .env and all environment variations (.env, .env.example, .env.*)
<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Protect sensitive configuration files, composer metadata, sql dumps, and logs
<FilesMatch "(^#.*#|\.(bak|conf|dist|fla|in[ci]|log|psd|sh|sql|sw[op])|~|composer\.(json|lock)|\.gitignore|\.gitattributes)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Rewrite rules to block direct HTTP access to sensitive directories
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Deny access to hidden directories and files (e.g. .git, .env)
    RewriteRule (^|/)\.(?!well-known) - [F,L,NC]

    # Deny direct HTTP access to sql directory
    RewriteRule ^sql(/.*)?$ - [F,L,NC]

    # Deny direct HTTP access to vendor directory
    RewriteRule ^vendor(/.*)?$ - [F,L,NC]

    # Allow extensionless access to existing PHP scripts (e.g. /register -> register.php)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>
